# Copia este archivo como .env y completa tus claves. NUNCA subas .env al repositorio.
#
# Una o varias keys de Groq separadas por coma (una cuenta por integrante, con el correo UTEC).
# Cada agente usa una key distinta (round-robin) para repartir el límite de tokens por minuto.
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxxxxxxxxxx,gsk_yyyyyyyyyyyyyyyyyyyyyyyy

# "groq" para la demo en vivo, "ollama" para desarrollar sin gastar cuota
BACKEND=groq

# Solo si usas Ollama (modelo con soporte de tools, p. ej. `ollama pull qwen3:8b`)
OLLAMA_MODEL=qwen3:8b
